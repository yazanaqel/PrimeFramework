@page "/dashboard"
@attribute [Authorize(Roles = "ADMIN")]
@inject AuthenticationStateProvider AuthProvider
@inject IAuthService AuthService
@inject NavigationManager Nav

@if(_info is not null)
{
    <section id="specialty">
        <h2 class="glitch">Dashboard</h2>
        <h2 class="glitch">Admin: @_info.Email</h2>
        <div class="specialty-grid">

            <div class="specialty-card" onclick="@GoToUsers">
                <div class="specialty-icon">👥</div>
                <h3>Users</h3>
            </div>

            <div class="specialty-card" onclick="@GoToStores">
                <div class="specialty-icon">💲</div>
                <h3>Stores</h3>
            </div>

            <div class="specialty-card" onclick="@GoToCategories">
                <div class="specialty-icon">🧮</div>
                <h3>Categories</h3>
            </div>

        </div>
    </section>
}
else
{
    <MudProgressLinear Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
}



@code {

    private async Task GoToUsers()
    {
        Nav.NavigateTo("/users",true);
    }
    private void GoToStores()
    {
        Nav.NavigateTo("/stores",true);
    }
    private void GoToCategories()
    {
        Nav.NavigateTo("/categories",true);
    }
}





@code {

    private UserProfileInfo? _info;

    protected override async Task OnInitializedAsync()
    {
        _info = await AuthService.GetUserProfileAsync();
    }

}