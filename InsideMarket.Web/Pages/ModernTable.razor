@page "/modern-table"

<div class="table-shell">
    <div class="table-header">
        <div class="table-title">
            <h2>@Title</h2>
            <span>@Subtitle</span>
        </div>
        <div class="table-pill">
            <span class="table-pill-dot"></span>
            <span>@PillText</span>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Item</th>
                <th>Owner</th>
                <th>Status</th>
                <th>Updated</th>
                <th class="cell-right">Progress</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var row in Rows)
            {
                <tr>
                    <td class="cell-primary">@row.Item</td>
                    <td class="cell-muted">@row.Owner</td>
                    <td>
                        <span class="badge @GetStatusClass(row.Status)">
                            @row.Status
                        </span>
                    </td>
                    <td class="cell-muted">@row.Updated</td>
                    <td class="cell-right cell-accent">@row.Progress%</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="footer">
        <span class="footer-text">@FooterText</span>
        <span class="footer-dot"></span>
    </div>
</div>



@code {
    public class TableRow
    {
        public string Item { get; set; } = "";
        public string Owner { get; set; } = "";
        public string Status { get; set; } = "";
        public string Updated { get; set; } = "";
        public int Progress { get; set; }
    }

    [Parameter] public string Title { get; set; } = "Project Overview";
    [Parameter] public string Subtitle { get; set; } = "Modern dark-mode list table for clean data display";
    [Parameter] public string PillText { get; set; } = "Live snapshot";
    [Parameter] public string FooterText { get; set; } = "Dark layout · Subtle hover · Accent-driven highlights";
    [Parameter]
    public List<TableRow> Rows { get; set; } = new()
    {
        new TableRow { Item = "Inside-Market API", Owner = "Yazan Aqel", Status = "Active", Updated = "2 hours ago", Progress = 82 },
        new TableRow { Item = "MAUI Shopping Basket", Owner = "Yazan Aqel", Status = "In review", Updated = "Yesterday", Progress = 64 },
        new TableRow { Item = "Windows Server Lab", Owner = "Lab Environment", Status = "Stable", Updated = "3 days ago", Progress = 100 },
        new TableRow { Item = "DAAD Application Draft", Owner = "Personal", Status = "Pending", Updated = "Last week", Progress = 28 },
    };

    private string GetStatusClass(string status) => status switch
    {
        "Active" or "Stable" => "badge-green",
        "In review" => "badge-yellow",
        "Pending" => "badge-red",
        _ => "badge-yellow"
    };
}