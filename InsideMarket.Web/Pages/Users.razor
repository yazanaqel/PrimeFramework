@page "/users"
@attribute [Authorize(Roles = "ADMIN")]
@inject IAuthService AuthService
@inject NavigationManager Nav


@if(!_users.Any())
{
    <MudProgressLinear Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
}
else
{

    <div class="table-shell">
        <div class="table-header">
            <div class="table-title">
                <h2>Title</h2>
                <span>Subtitle</span>
            </div>
            <div class="table-pill">
                <span class="table-pill-dot"></span>
                <span>PillText</span>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>User Id</th>
                    <th>Username</th>
                    <th>Email Confirmed</th>
                    <th>Phone Number</th>
                    <th class="cell-right">Created At</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var user in _users)
                {
                    <tr>
                        <td class="cell-primary" onclick="@(() => GoToUserDetails(user.UserId))" style="cursor:pointer">@user.UserId</td>
                        <td class="cell-muted">@user.UserName</td>
                        <td>
                            <span class="badge @GetStatusClass(user.EmailConfirmed.ToString().ToLower())">
                                @user.EmailConfirmed
                            </span>
                        </td>
                        <td class="cell-muted">@user.PhoneNumber</td>
                        <td class="cell-right cell-accent">@user.CreatedAt</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="footer">
            <span class="footer-text">FooterText</span>
            <span class="footer-dot"></span>
        </div>
    </div>



}


@code {
    private IReadOnlyList<GetAllUsersResponse> _users = new List<GetAllUsersResponse>();

    protected override async Task OnInitializedAsync()
    {
        var result = await AuthService.GetAllUsersAsync();

        if(result is not null)
        {
            _users = result.Items.ToList();
        }
    }

    private void GoToUserDetails(string userId)
    {
        Nav.NavigateTo($"/user/details/{userId}",true);
    }



    private string GetStatusClass(string status) => status switch
    {
        "true" or "Stable" => "badge-green",
        "In review" => "badge-yellow",
        "false" => "badge-red",
        _ => "badge-yellow"
    };
}

