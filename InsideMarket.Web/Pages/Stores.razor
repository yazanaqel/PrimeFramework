@page "/stores"
@inject IAuthService AuthService
@inject NavigationManager Nav

@if(!_stores.Any())
{
    <MudProgressLinear Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
}
else
{


    <PageTitle>Stores</PageTitle>

    <div class="products-page page-content">
        <header class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h2 class="page-title">Stores</h2>
                <p class="page-subtitle">Manage Stores.</p>
            </div>
            <div>
                <input class="form-control form-control-dark" placeholder="Search products..." @bind="query" />
            </div>
        </header>

        <section class="products-grid">
            @foreach(var p in Filtered)
            {
                <article class="product-card card bg-surface">
                    <div class="product-media" style="background-image: url('@p.ImageCover'); background-size: cover; background-position: center; background-repeat: no-repeat;">
                        <div class="badge @BadgeClass(p.StoreStatus)">@BadgeText(p.StoreStatus)</div>
                    </div>
                    <div class="product-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div class="product-title">@p.Name</div>
                                <div class="product-meta small text-muted">@p.Description</div>
                            </div>
                            <div class="product-avatar" style="background-image: url('@p.Image');" title="profile"></div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between">
                            <div class="rating" title="stars">
                                @for(int i = 1;i <= 5;i++)
                                {
                                    <svg class="star" width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M12 .587l3.668 7.431L23.5 9.748l-5.75 5.603L19.334 24 12 20.013 4.666 24l1.584-8.649L.5 9.748l7.832-1.73L12 .587z" fill="@(i <= Math.Round(3.3) ? "#f6c84c" : "rgba(255,255,255,0.06)")" />
                                    </svg>
                                }
                            </div>

                            <div>
                                <button class="btn btn-primary btn-sm" onclick="@(() => NavigateToMarket(p.StoreId))">Details</button>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </section>
    </div>

    <style>
        .form-control-dark {
            background: #0b1116;
            border: 1px solid var(--border);
            color: var(--text);
            width: 260px
        }
    </style>

}


@code {

    private List<Store> _stores = new();
    string query = string.Empty;

    IEnumerable<Store> Filtered => string.IsNullOrWhiteSpace(query)
        ? _stores
        : _stores.Where(p => p.Name.Contains(query,StringComparison.OrdinalIgnoreCase) || p.Description.Contains(query,StringComparison.OrdinalIgnoreCase));


    protected override async Task OnInitializedAsync()
    {

        var response = await AuthService.GetAllStores();

        _stores = response.ToList();

    }

    private void NavigateToMarket(string id)
    {
        Nav.NavigateTo($"/store/details/{id}");
    }

    string BadgeText(StoreStatus b) => b switch
    {
        StoreStatus.Active => "Active",
        StoreStatus.Suspended => "Suspended",
        StoreStatus.Draft => "Draft",
        _ => string.Empty
    };

    string BadgeClass(StoreStatus b) => b switch
    {
        StoreStatus.Active => "badge--new",
        StoreStatus.Suspended => "badge--discount",
        StoreStatus.Draft => "badge--soon",
        _ => string.Empty
    };

}

