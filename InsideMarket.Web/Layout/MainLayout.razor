@inherits LayoutComponentBase
@attribute [Authorize(Roles = "ADMIN")]
@inject IAuthService AuthService
@inject IJSRuntime JS
@inject NavigationManager Navigation


<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center auth">
            <button class="btn btn-link ms-2 text-danger" @onclick="ShowLogoutDialog">Logout</button>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool showLogoutConfirm;

    private void ShowLogoutDialog()
    {
        showLogoutConfirm = true;
    }

    private void CancelLogout()
    {
        showLogoutConfirm = false;
    }

    private async Task DoLogout()
    {
        showLogoutConfirm = false;
        
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login",true);
    }
}

@if(showLogoutConfirm)
{
    <div class="modal-overlay" @onclick="CancelLogout">
        <div class="logout-modal" @onclick:stopPropagation>
            <h5 class="mb-1">Sign out of BlazorApp1?</h5>
            <p class="text-muted mb-3">You will be signed out and returned to the home page.</p>
            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-outline-light" @onclick="CancelLogout">Cancel</button>
                <button class="btn btn-danger" @onclick="DoLogout">Sign out</button>
            </div>
        </div>
    </div>
}
