@page "/order/shopping-details"
@attribute [Authorize]
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider


<section id="specialty">
    <h2 class="glitch">shopping details</h2>
    <div class="specialty-grid">

        <div class="specialty-card" onclick="@GoToShoppingBasket">
            <div class="specialty-icon">🛍️</div>
            <h3>Shopping Basket</h3>
        </div>

        <div class="specialty-card" onclick="@GoToOrders">
            <div class="specialty-icon">📃</div>
            <h3>Check my orders</h3>
        </div>

    </div>
</section>


@code {

    private async Task GoToOrders()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        switch(user)
        {
            case var _ when user.IsInRole("MERCHANT"):
                Nav.NavigateTo("/order/store-orders",true);
                break;
            case var _ when user.IsInRole("USER"):
                Nav.NavigateTo("/order/user-orders",true);
                break;
        }
    }
    private void GoToShoppingBasket()
    {
        Nav.NavigateTo("/order/shopping-basket",true);
    }
}
