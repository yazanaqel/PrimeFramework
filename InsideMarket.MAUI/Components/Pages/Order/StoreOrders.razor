@page "/order/store-orders"
@attribute [Authorize(Roles ="MERCHANT")]
@inject IOrderService OrderService


@if(_storeOrders.Any())
{

    <section id="menu">
        <div class="menu-container">
            <div class="menu-category">
                <h3>Shopping Basket</h3>
                <ul class="menu-list">

                    @foreach(var item in _storeOrders)
                    {
                        <li>
                            <a>
                                <span class="menu-item-name">@item.UserId</span>
                                <span class="menu-item-price">$@item.ProductName</span>
                            </a>
                        </li>
                    }
                </ul>

            </div>
        </div>
    </section>
}
else
{
    <section id="home">

        <p class="hero-subtitle">
            you don't have orders yet! see some <MudLink Color="Color.Success" Href="/house/all-products">products</MudLink>.
        </p>

    </section>
}


@code {
    private IEnumerable<GetStoreOrdersResponse> _storeOrders = new List<GetStoreOrdersResponse>();
    private bool _isBusy = false;

    protected override async Task OnInitializedAsync()
    {
        _storeOrders = await OrderService.GetStoreOrders();
    }


}