@page "/order/shopping-basket"
@attribute [Authorize]
@inject IBasketService BasketService
@inject IOrderService OrderService
@inject NavigationManager Nav

@if(_productsInBasket.Any())
{
    <section id="menu">
        <div class="menu-container">
            <div class="menu-category">
                <h3>Shopping Basket</h3>
                <ul class="menu-list">

                    @foreach(var item in _productsInBasket)
                    {
                        <li>
                            <a>
                                <span class="menu-item-name">@item.Name</span>
                                <span class="menu-item-price">$@item.UnitPrice | Quantity: @item.Quantity</span>
                            </a>
                        </li>
                    }
                </ul>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Class="submit-btn"
                           FullWidth="true"
                           Disabled="@_isBusy"
                           OnClick="SubmitOrder">

                    @if(_isBusy)
                    {
                        <MudProgressCircular Color="Color.Success" Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <MudText>submit order</MudText>
                    }
                </MudButton>

            </div>
        </div>
    </section>

}
else
{

    <section id="home">

        <p class="hero-subtitle">
            oh empty basket!, let's see some <MudLink Color="Color.Success" Href="/house/all-products">products</MudLink>.
        </p>

    </section>
}

@code {

    private List<ProductInBasket> _productsInBasket = new List<ProductInBasket>();
    private bool _isBusy = false;

    protected override async Task OnInitializedAsync()
    {
        _productsInBasket = await BasketService.LoadBasket();
    }

    private async Task SubmitOrder()
    {
        _isBusy = true;
        List<CreateOrderRequest> orderRequests = new List<CreateOrderRequest>();

        foreach(var item in _productsInBasket)
        {
            orderRequests.Add(new CreateOrderRequest
            {
                ProductId = item.ProductId,
                Quantity = item.Quantity
            });
        }

        var result = await OrderService.CreateOrder(orderRequests);

        if(result)
        {
            await BasketService.ClearBasket();
            Nav.NavigateTo("/house/all-stores");
        }
        else
        {
            _isBusy = false;
            // Handle order submission failure (e.g., show an error message)
        }
    }
}
