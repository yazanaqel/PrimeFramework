@page "/order/user-orders"
@attribute [Authorize]
@inject IOrderService OrderService
@inject NavigationManager Nav

@if(_userOrders.Any())
{

    <section id="menu">
        <div class="menu-container">
            <div class="menu-category">
                <h3>Submited Orders</h3>
                <ul class="menu-list">

                    @foreach(var item in _userOrders)
                    {
                        <li>
                            <a>
                                <span class="menu-item-name">@item.OrderId</span>
                                <span class="menu-item-price">@item.StoreName</span>
                                <span class="menu-item-price">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" onclick="@(() => GoToOrderDetails(item.OrderId))" />
                                </span>
                            </a>
                        </li>
                    }
                </ul>

            </div>
        </div>
    </section>
}
else
{
    <section id="home">

        <p class="hero-subtitle">
            you don't have orders yet! see some <MudLink Color="Color.Success" Href="/house/all-products">products</MudLink>.
        </p>

    </section>
}

@code {
    private IEnumerable<GetUserOrdersResponse> _userOrders = new List<GetUserOrdersResponse>();
    private bool _isBusy = false;

    protected override async Task OnInitializedAsync()
    {
        _userOrders = await OrderService.GetUserOrders();
    }

    private void GoToOrderDetails(string orderId)
    {
        Nav.NavigateTo($"/order/user-order-details/{orderId}",true);
    }
}