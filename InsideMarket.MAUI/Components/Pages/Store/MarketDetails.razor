@page "/markets/{id:guid}"
@inject IStoreService StoreService
@inject IProductService ProductService

<h3>MarketDetails</h3>
@if(store is not null)
{
    <p>@store.Name</p>

    @if(products is not null && products.Count > 0)
    {
        foreach(var product in products)
        {
            <p>@product.Name</p>
        }
    }
    else
    {
        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
    }
}
else
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
}

@code {

    [Parameter] public Guid Id { get; set; }

    private InsideMarket.MAUI.Business.Models.Store? store = new();
    private List<InsideMarket.MAUI.Business.Models.Product>? products = new();

    protected override async Task OnInitializedAsync()
    {
        store = await StoreService.GetStore(Id);

        products = await ProductService.GetStoreProducts(Id);
            
    }
}
