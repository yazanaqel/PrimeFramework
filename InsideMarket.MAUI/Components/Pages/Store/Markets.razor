@page "/markets"
@attribute [AllowAnonymous]
@using InsideMarket.MAUI.Components.Pages.Store
@inject IStoreService StoreService
@inject NavigationManager Nav

@if(stores is null || !stores.Any())
{
    <Loading />
}
else
{
    <MudGrid>

        <MudItem xs="12">

            <MudTextField T="string"
                          Label="Search"
                          @bind-Value="SearchText"
                          Immediate="true"
                          Clearable="true" />
        </MudItem>

        <MudItem xs="6">
            somthing here
        </MudItem>

        <MudItem xs="6">
            somthing here
        </MudItem>

        @if(string.IsNullOrEmpty(SearchText))
        {
            @foreach(var store in stores)
            {
                <MudItem xs="6">
                    <MudCard>
                        <MudImage Src="images/mug.png" Alt="Mug" Elevation="25" />
                        <MudCardContent>
                            <MudText Typo="Typo.h5">@store.Name</MudText>
                            <MudText Typo="Typo.body2">@store.Description</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => NavigateToMarket(store.Id))">
                                Details
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Primary">+</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }
        else if(!string.IsNullOrEmpty(SearchText))
        {
            @foreach(var store in searchList)
            {
                <MudItem xs="6">
                    <MudCard>
                        <MudImage Src="images/mug.png" Alt="Mug" Elevation="25" />
                        <MudCardContent>
                            <MudText Typo="Typo.h5">@store.Name</MudText>
                            <MudText Typo="Typo.body2">@store.Description</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => NavigateToMarket(store.Id))">
                                Details
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Primary">+</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }



    </MudGrid>

}




@code {


    private List<InsideMarket.MAUI.Business.Models.Store>? stores = new();
    private List<InsideMarket.MAUI.Business.Models.Store>? searchList = new();

    protected override async Task OnInitializedAsync()
    {
        var response = await StoreService.GetAllStores(new GetAllStoresRequest());

        if(response.Any())
        {
            stores = response.ToList();
        }

    }

    private void NavigateToMarket(Guid id)
    {
        Nav.NavigateTo($"/markets/{id}");
    }

    private string? _searchText;

    private string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            UpdateResults();
        }
    }

    private void UpdateResults()
    {
        if(searchList is not null && string.IsNullOrEmpty(_searchText))
        {
            searchList = stores;
            return;
        }

        searchList = stores
            .Where(x => x.Name.Contains(_searchText,StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
}
