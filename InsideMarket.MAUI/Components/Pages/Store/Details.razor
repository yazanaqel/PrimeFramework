@page "/store/details/{id:guid}"
@inject IStoreService StoreService
@inject IProductService ProductService
@inject IBasketService BasketService
@inject NavigationManager Nav

@if(_store is null)
{
    <Loading />
}
else
{


    <div id="story" class="tab-content active">

        <!-- Cover -->
        <div class="cover-wrapper">
            <img src="@_store.ImageCover" alt="Cover Image">
        </div>

        <!-- Profile -->
        <div class="profile-wrapper">
            <img src="@_store.Image" alt="Profile Image">
        </div>

        <!-- Name + Bio -->
        <div class="profile-info">
            <h2>@_store.Name</h2>
            <p>@_store.Description</p>
            <p>@_store.City</p>
            <p>@_store.Address</p>
        </div>

    </div>


    <MudGrid>

        <MudItem xs="12">

            <MudTextField T="string"
                          Label="Search"
                          @bind-Value="SearchText"
                          Immediate="true"
                          Clearable="true" />
        </MudItem>

        @if(_products is null || !_products.Any())
        {
            <Loading />
        }
        else if(string.IsNullOrEmpty(SearchText))
        {
            foreach(var product in _products)
            {
                <MudItem xs="6">
                    <MudCard>
                        <MudImage Src="@product.Image" Alt="Mug" Elevation="25" />
                        <MudCardContent>
                            <MudText Typo="Typo.h5">@product.Name</MudText>
                            <MudText Typo="Typo.body2">@product.Description</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => NavigateToProductDetails(product.ProductId))">
                                Details
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }
        else if(!string.IsNullOrEmpty(SearchText))
        {
            foreach(var product in searchList)
            {
                <MudItem xs="6">
                    <MudCard>
                        <MudImage Src="images/mug.png" Alt="Mug" Elevation="25" />
                        <MudCardContent>
                            <MudText Typo="Typo.h5">@product.Name</MudText>
                            <MudText Typo="Typo.body2">@product.Description</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary">+</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }
    </MudGrid>
}

@code {

    [Parameter] public Guid Id { get; set; }

    private InsideMarket.MAUI.Business.Models.Store? _store = new();
    private List<InsideMarket.MAUI.Business.Models.Product>? _products = new();
    private List<InsideMarket.MAUI.Business.Models.Product>? searchList = new();
    private List<ProductInBasket> __productsInBasket = new List<ProductInBasket>();

    protected override async Task OnParametersSetAsync()
    {
        _store = await StoreService.GetStore(Id);

        _products = await ProductService.GetStoreProducts(Id);

    }

    private string? _searchText;

    private string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            UpdateResults();
        }
    }

    private void UpdateResults()
    {
        if(searchList is not null && string.IsNullOrEmpty(_searchText))
        {
            searchList = _products;
            return;
        }

        searchList = _products
            .Where(x => x.Name.Contains(_searchText,StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void NavigateToProductDetails(string id)
    {
        Nav.NavigateTo($"/product/details/{id}");
    }
}
