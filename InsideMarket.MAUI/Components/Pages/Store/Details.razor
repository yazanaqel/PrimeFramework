@page "/store/details/{id:guid}"
@inject IStoreService StoreService
@inject IProductService ProductService
@inject IBasketService BasketService

@if(store is null)
{
    <Loading />
}
else
{
    <MudGrid Spacing="0">

        <MudItem xs="12">
            <div style="aspect-ratio: 16 / 9; width: 100%;">
                <MudImage Src="@store.ImageCover" Style="width:100%; height:100%; object-fit:cover;" />
            </div>
        </MudItem>

        <MudItem xs="4">
            <div style="aspect-ratio: 1 / 1; width: 100%;">
                <MudImage Src="@store.Image" Style="width:100%; height:100%; object-fit:cover;" />
            </div>
        </MudItem>

        <MudItem xs="6">
            <MudText Typo="Typo.h4" Class="m-3">
                @store.Name
            </MudText>
        </MudItem>



    </MudGrid>

    <MudGrid>

        <MudItem xs="12">

            <MudTextField T="string"
                          Label="Search"
                          @bind-Value="SearchText"
                          Immediate="true"
                          Clearable="true" />
        </MudItem>

        @if(products is null || !products.Any())
        {
            <Loading />
        }
        else if(string.IsNullOrEmpty(SearchText))
        {
            foreach(var product in products)
            {
                <MudItem xs="6">
                    <MudCard>
                        <MudImage Src="@product.Image" Alt="Mug" Elevation="25" />
                        <MudCardContent>
                            <MudText Typo="Typo.h5">@product.Name</MudText>
                            <MudText Typo="Typo.body2">@product.Description</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            @*                             <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => NavigateToMarket(product.Id))">
                                Details
                            </MudButton> *@
                            <MudIconButton Icon="@Icons.Material.Outlined.AddToQueue"
                                           Color="Color.Default"
                                           Size="Size.Medium"
                                           OnClick="@(() => AddToCart(product))" />
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }
        else if(!string.IsNullOrEmpty(SearchText))
        {
            foreach(var product in searchList)
            {
                <MudItem xs="6">
                    <MudCard>
                        <MudImage Src="images/mug.png" Alt="Mug" Elevation="25" />
                        <MudCardContent>
                            <MudText Typo="Typo.h5">@product.Name</MudText>
                            <MudText Typo="Typo.body2">@product.Description</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary">+</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }
    </MudGrid>
}

@code {

    [Parameter] public Guid Id { get; set; }

    private InsideMarket.MAUI.Business.Models.Store? store = new();
    private List<InsideMarket.MAUI.Business.Models.Product>? products = new();
    private List<InsideMarket.MAUI.Business.Models.Product>? searchList = new();
    private List<ProductInBasket> _productsInBasket = new List<ProductInBasket>();

    protected override async Task OnInitializedAsync()
    {
        store = await StoreService.GetStore(Id);

        products = await ProductService.GetStoreProducts(Id);

    }

    private string? _searchText;

    private string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            UpdateResults();
        }
    }

    private void UpdateResults()
    {
        if(searchList is not null && string.IsNullOrEmpty(_searchText))
        {
            searchList = products;
            return;
        }

        searchList = products
            .Where(x => x.Name.Contains(_searchText,StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void AddToCart(Product product)
    {
        var productInBasket = new ProductInBasket
        {
            ProductId = product.ProductId,
            Name = product.Name,
            UnitPrice = product.UnitPrice,
            Quantity = 1
        };
        _productsInBasket.Add(productInBasket);
        BasketService.SaveBasket(_productsInBasket);
    }
}
