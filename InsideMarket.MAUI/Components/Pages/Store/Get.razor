@page "/store/get"
@attribute [Authorize(Roles = "MERCHANT")]
@inject IStoreService StoreService
@inject ICategoryService CategoryService
@inject IProductService ProductService
@inject NavigationManager Nav
@inject HttpClient httpClient

@if(_store is null)
{
    <Loading />
}
else
{

    <div id="story" class="tab-content active">

        <!-- Cover -->
        <div class="cover-wrapper">
            <img src="@_store.ImageCover" alt="Cover Image">
        </div>

        <!-- Profile -->
        <div class="profile-wrapper">
            <img src="@_store.Image" alt="Profile Image">
        </div>

    </div>


    @if(_products is not null && _products.Any())
    {

        <section id="menu">
            <div class="menu-container">
                <div class="menu-category">
                    <h3>Store Products</h3>
                    <ul class="menu-list">

                        <li>
                            <a href="/product/create">
                                <span class="menu-item-name">
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Success" /> add new product
                                </span>
                            </a>
                        </li>

                        @foreach(var item in _products)
                        {
                            <li>
                                <a>
                                    <span class="menu-item-name">Name: @item.Name</span>
                                    <span class="menu-item-price">Stock Quantity: @item.StockQuantity</span>
                                    <span class="menu-item-price">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" />
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </section>
    }
    else
    {
        <section id="home">

            <p class="hero-subtitle">
                you don't have products yet! add some <MudLink Color="Color.Success" Href="/product/create">products</MudLink>.
            </p>

        </section>
    }

}





@code {

    private InsideMarket.MAUI.Business.Models.Store? _store = new();
    private List<InsideMarket.MAUI.Business.Models.Product>? _products = new();


    protected override async Task OnInitializedAsync()
    {

        _store = await StoreService.GetStore();

        if(_store is null)
        {
            Nav.NavigateTo("/store/create",true);
        }
        else
        {
            _products = await ProductService.GetStoreProducts();
        }

    }


}


