@page "/store/create"
@attribute [Authorize(Roles = "MERCHANT")]
@inject ICategoryService CategoryService
@inject IStoreService StoreService
@inject NavigationManager Nav



<section id="home">
    <p class="hero-subtitle">
        let's create your store
    </p>
    <div class="contact-container">
        <div class="contact-form">

            @if(!string.IsNullOrEmpty(ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                    @ErrorMessage
                </MudAlert>
            }

            <EditForm Model="@_store" OnValidSubmit="@CreateStore">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="@_store.Name">Store name</label>
                    <MudTextField @bind-Value="_store.Name"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  For="@(() => _store.Name)" />
                </div>

                <div class="form-group">
                    <label for="@_store.CategoryId">Store category</label>
                    @if(categories is not null)
                    {
                        <InputSelect TValue="string" class="form-select" @bind-Value="_store.CategoryId">
                            @foreach(var category in categories)
                            {
                                <option value="@category.CategoryId">@category.Name</option>
                            }
                        </InputSelect>
                    }
                </div>

                <div class="form-group">
                    <label for="@_store.Description">Tell people about your store</label>
                    <MudTextField @bind-Value="_store.Description"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  For="@(() => _store.Description)" />

                </div>

                <div class="form-group">
                    <label for="@_store.City">Choose your city</label>
                    <InputSelect class="form-select" @bind-Value="_store.City">
                        @foreach(var value in Enum.GetValues<InsideMarket.MAUI.Enums.City>())
                        {
                            <option value="@value">@value</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-group">
                    <label for="@_store.Address">Store address</label>
                    <MudTextField @bind-Value="_store.Address"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  For="@(() => _store.Address)" />

                </div>

                <div class="form-group">
                    <label for="@_store.Image">Select your store image</label>
                    <MudIconButton Icon="@Icons.Material.Filled.Image"
                                   Color="@Color.Info"
                                   OnClick="@(() => PickImage())" />

                </div>

                <div class="form-group">
                    <label for="@_store.ImageCover">Select your store cover image</label>
                    <MudIconButton Icon="@Icons.Material.Filled.Image"
                                   Color="@Color.Info"
                                   OnClick="@(() => PickCoverImage())" />

                </div>

                <div class="form-group">
                    <label for="@_store.IsShippingAvailable">Do you offer shipping?</label>
                    <MudSwitch @bind-Value="_store.IsShippingAvailable"
                               Color="Color.Primary" />

                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Class="submit-btn"
                           FullWidth="true"
                           Disabled="@_isBusy"
                           OnClick="CreateStore">

                    @if(_isBusy)
                    {
                        <MudProgressCircular Color="Color.Success" Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <MudText>Create My Store</MudText>
                    }
                </MudButton>
            </EditForm>

        </div>
    </div>
</section>


@code {

    private InsideMarket.MAUI.Business.Models.Store _store = new();
    private bool _isBusy = false;
    private string? ErrorMessage;

    private async Task CreateStore()
    {
        ErrorMessage = null;
        _isBusy = true;

        var success = await StoreService.CreateStore(_store);

        if(success)
        {
            _isBusy = false;
            Nav.NavigateTo("/store/get");
        }
        else
        {
            ErrorMessage = "Failed to create store. Please try again.";
            _isBusy = false;
        }

    }

    private List<InsideMarket.MAUI.Business.Models.Category>? categories = new();

    protected override async Task OnInitializedAsync()
    {

        categories = await CategoryService.GetAllCategories();

        if(categories is null || !categories.Any())
        {
            ErrorMessage = "No categories available. Please create a category first.";
            return;
        }

        categories = categories.Where(c => c.ChildrenResponses != null).Select(c => c).ToList();

        _store.CategoryId = categories.FirstOrDefault()?.CategoryId;
    }

    private async Task PickImage()
    {
        var result = await FilePicker.PickAsync(new PickOptions
        {
            PickerTitle = "Select an image",
            FileTypes = FilePickerFileType.Images
        });

        if(result != null)
        {
            var stream = await result.OpenReadAsync();

            _store.ImageStream = stream;
            _store.ImageFileName = result.FileName;
        }
    }

    private async Task PickCoverImage()
    {
        var result = await FilePicker.PickAsync(new PickOptions
        {
            PickerTitle = "Select an image",
            FileTypes = FilePickerFileType.Images
        });

        if(result != null)
        {
            var stream = await result.OpenReadAsync();

            _store.ImageCoverStream = stream;
            _store.ImageCoverFileName = result.FileName;
        }
    }

}
