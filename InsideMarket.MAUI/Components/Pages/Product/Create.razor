@page "/product/create"
@attribute [Authorize(Roles = "MERCHANT")]
@inject ICategoryService CategoryService
@inject IProductService ProductService
@inject IStoreService StoreService
@inject NavigationManager Nav

<MudPaper Class="pa-6 mx-auto mt-10" Elevation="8" MaxWidth="400px">

    <MudText Typo="Typo.h5" Class="mb-4">Create Product</MudText>
    @if(!string.IsNullOrEmpty(ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
            @ErrorMessage
        </MudAlert>
    }

    <EditForm Model="@_product" OnValidSubmit="@CreateProduct">
        <DataAnnotationsValidator />

        <MudTextField @bind-Value="_product.Name"
                      Label="Product Name"
                      Variant="Variant.Outlined"
                      Required="true"
                      For="@(() => _product.Name)" />

        <MudTextField @bind-Value="_product.Description"
                      Label="Product Description"
                      Variant="Variant.Outlined"
                      Required="true"
                      For="@(() => _product.Description)" />

        <MudNumericField @bind-Value="_product.StockQuantity"
                         Label="Stock Quantity"
                         Variant="Variant.Outlined"
                         Required="true"
                         For="@(() => _product.StockQuantity)" />

        <MudNumericField @bind-Value="_product.UnitPrice"
                         Label="Product Unit Price"
                         Variant="Variant.Outlined"
                         Required="true"
                         For="@(() => _product.UnitPrice)" />
        <MudItem>
            @if (_childrenResponse is not null)
            {
                <InputSelect TValue="string" class="form-select" @bind-Value="_product.CategoryId">
                    @foreach (var child in _childrenResponse)
                    {
                        <option value="@child.CategoryId">@child.Name</option>
                    }
                </InputSelect>
            }
        </MudItem>

        <MudItem>
            <MudText>Product Image</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Image"
                           Color="@Color.Info"
                           OnClick="@(() => PickImage())" />
        </MudItem>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Class="mt-4"
                   FullWidth="true"
                   Disabled="@_isBusy"
                   OnClick="CreateProduct">

            @if(_isBusy)
            {
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Create</MudText>
            }
        </MudButton>

    </EditForm>

</MudPaper>




@code {
    private MAUI.Business.Models.Product _product = new();
    private List<InsideMarket.MAUI.Business.Models.ChildrenResponse> _childrenResponse = new();

    private bool _isBusy = false;
    private string? ErrorMessage;


    protected override async Task OnInitializedAsync()
    {

        var categories = await CategoryService.GetAllCategories();

        if(categories != null)
        {
            _childrenResponse = categories.Where(c => c.ChildrenResponses != null).SelectMany(c => c.ChildrenResponses).ToList();
        }

    }


    private async Task CreateProduct()
    {
        ErrorMessage = null;
        _isBusy = true;

        var success = await ProductService.CreateProduct(_product);

        if(success)
        {
            _isBusy = false;
            Nav.NavigateTo("/store/get");
        }
        else
        {
            ErrorMessage = "Failed to create product. Please try again.";
            _isBusy = false;
        }

    }

    private async Task PickImage()
    {
        var result = await FilePicker.PickAsync(new PickOptions
        {
            PickerTitle = "Select an image",
            FileTypes = FilePickerFileType.Images
        });

        if(result != null)
        {
            var stream = await result.OpenReadAsync();

            _product.ImageStream = stream;
            _product.ImageFileName = result.FileName;
        }
    }

}
