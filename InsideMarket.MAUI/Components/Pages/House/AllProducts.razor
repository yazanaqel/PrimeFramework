</MudGrid>


    @code {


    private IEnumerable<InsideMarket.MAUI.Business.Models.GetAllProductsResponse>? _categorizedProducts = new List<InsideMarket.MAUI.Business.Models.GetAllProductsResponse>();
    private IEnumerable<InsideMarket.MAUI.Business.Models.GetAllProductsResponse>? searchList = new List<InsideMarket.MAUI.Business.Models.GetAllProductsResponse>();
    private Dictionary<string,List<InsideMarket.MAUI.Business.Models.GetAllProductsResponse>> _groupedProducts = new Dictionary<string,List<InsideMarket.MAUI.Business.Models.GetAllProductsResponse>>();

    protected override async Task OnInitializedAsync()
    {
        _categorizedProducts = await ProductService.GetCategorizedProducts();

        _groupedProducts = _categorizedProducts
            .GroupBy(p => p.CategoryName)
            .ToDictionary(g => g.Key,g => g.ToList());
    }


    private string? _searchText;

    private string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            UpdateResults();
        }
    }

    private void UpdateResults()
    {
        if(searchList is not null && string.IsNullOrEmpty(_searchText))
        {
            searchList = _categorizedProducts;
            return;
        }

        searchList = _categorizedProducts
            .Where(x =>
                x.CategoryName.Contains(_searchText,StringComparison.OrdinalIgnoreCase)||
            x.ProductName.Contains(_searchText,StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
    private void NavigateToProductDetails(string id)
    {
        Nav.NavigateTo($"/product/details/{id}");
    }
}
