@page "/house/all-products"
@inject IProductService ProductService
@inject NavigationManager Nav


<MudGrid>

    <MudItem xs="12">

        <MudTextField T="string"
                      Label="Search"
                      @bind-Value="SearchText"
                      Immediate="true"
                      Clearable="true" />
    </MudItem>

    @if(_categorizedProducts is null || !_categorizedProducts.Any())
    {
        <Loading />
    }
    else
    {
        foreach(var item in _groupedProducts)
        {
            <MudItem xs="12">
                <h2 class="glitch">@item.Key</h2>
            </MudItem>
            
            @foreach(var product in item.Value)
            {

                <MudItem xs="6">
                    <MudCard>
                        <MudImage Src="@product.Image" Alt="Mug" Elevation="25" />
                        <MudCardContent>
                            <MudText Typo="Typo.h5">@product.ProductName</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => NavigateToProductDetails(product.ProductId))">
                                Details
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
               
        }
    }
@*     else if(searchList is not null && !string.IsNullOrEmpty(SearchText))
    {
