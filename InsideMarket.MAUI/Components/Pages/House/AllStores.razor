@page "/house/all-stores"
@attribute [AllowAnonymous]
@inject IStoreService StoreService
@inject NavigationManager Nav
@inject IJSRuntime JS

@if(!_stores.Any())
{
    <Loading />
}
else
{


    <div class="deck">

        <button class="nav-button prev" @onclick="() => Previous()">-</button>
        <button class="nav-button next" @onclick="() => Next()">+</button>

        <div class="slide active">

            <div class="bg">
                <img src="@_stores[0].ImageCover" />
            </div>

            <div class="content">
                <h1>@_stores[0].Name</h1>
            </div>

        </div>

        @if(_stores.Count > 0)
        {
            @foreach(var item in _stores)
            {
                <div class="slide">

                    <div class="bg">
                        <img src="@item.ImageCover" />
                    </div>

                    <div class="content">
                        <h1>@item.Name</h1>
                    </div>

                </div>
            }
        }


    </div>



    <MudGrid>

        <MudItem xs="12">

            <MudTextField T="string"
                          Label="Search"
                          @bind-Value="SearchText"
                          Immediate="true"
                          Clearable="true" />
        </MudItem>

        @if(string.IsNullOrEmpty(SearchText))
        {
            @foreach(var store in _stores)
            {
                <MudItem xs="6">
                    <MudCard>
                        <MudImage Src="@store.Image" Alt="Mug" Elevation="25" />
                        <MudCardContent>
                            <MudText Typo="Typo.h5">@store.Name</MudText>
                            <MudText Typo="Typo.body2">@store.Description</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => NavigateToMarket(store.StoreId))">
                                Details
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }
        else if(!string.IsNullOrEmpty(SearchText))
        {
            @foreach(var store in searchList)
            {
                <MudItem xs="6">
                    <MudCard>
                        <MudImage Src="@store.Image" Alt="Mug" Elevation="25" />
                        <MudCardContent>
                            <MudText Typo="Typo.h5">@store.Name</MudText>
                            <MudText Typo="Typo.body2">@store.Description</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => NavigateToMarket(store.StoreId))">
                                Details
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }



    </MudGrid>

}




@code {


    private List<InsideMarket.MAUI.Business.Models.Store> _stores = new();
    // private List<InsideMarket.MAUI.Business.Models.Store> _sliderStores = new();
    private List<InsideMarket.MAUI.Business.Models.Store> searchList = new();

    protected override async Task OnInitializedAsync()
    {

        var response = await StoreService.GetAllStores(new GetAllStoresRequest());

        if(response.Any())
        {
            _stores = response.Where(s => s.StoreStatus == Enums.StoreStatus.Active).ToList();

            // if(_stores.Count > 3)
            // {
            //     var firstFive = _stores.Skip(1).Take(2).ToList();

            //     _sliderStores.AddRange(firstFive);
            // }

        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
            await JS.InvokeVoidAsync("enableSwipe");
    }

    async Task Next()
    {
        await JS.InvokeVoidAsync("prevSlide");
    }
    async Task Previous()
    {
        await JS.InvokeVoidAsync("prevSlide");
    }

    private void NavigateToMarket(string id)
    {
        Nav.NavigateTo($"/store/details/{id}");
    }

    private string? _searchText;

    private string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            UpdateResults();
        }
    }

    private void UpdateResults()
    {
        if(searchList is not null && string.IsNullOrEmpty(_searchText))
        {
            searchList = _stores;
            return;
        }

        searchList = _stores
            .Where(x => x.Name.Contains(_searchText,StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
}
