@page "/user/get"
@attribute [Authorize]
@inject NavigationManager Nav
@inject IAuthService AuthService



@if(_user is null || string.IsNullOrWhiteSpace(_user.Email))
{
    <Loading />
}
else
{

    <section id="menu">
        <div class="menu-container">
            <div class="menu-category">
                <h3>Profile</h3>
                <ul class="menu-list">

                    <li>
                        <a>
                            <span class="menu-item-name">Email:</span>
                            <span class="menu-item-name">@_user.Email</span>
                            <span class="menu-item-price">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" />
                            </span>
                        </a>
                    </li>

                    <li>
                        <a>
                            <span class="menu-item-name">UserName:</span>
                            <span class="menu-item-name">@_user.UserName</span>
                            <span class="menu-item-price">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" />
                            </span>
                        </a>
                    </li>

                </ul>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Class="submit-btn"
                           FullWidth="true"
                           Disabled="@_isBusy"
                           OnClick="Save">

                    @if(_isBusy)
                    {
                        <MudProgressCircular Color="Color.Success" Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <MudText>Save</MudText>
                    }
                </MudButton>

            </div>
        </div>
    </section>

}


@code {


    private UserProfileInfo _user = new UserProfileInfo();
    private bool _isBusy = false;

    protected override async Task OnInitializedAsync()
    {
        _user = await AuthService.GetUserProfileAsync();

        if(_user == null)
        {
            Nav.NavigateTo("/login");
        }
    }

    private void Save()
    {
        
    }
}
