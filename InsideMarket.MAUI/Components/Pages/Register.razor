@page "/register"
@layout LoginLayout
@inject IAuthService AuthService
@inject NavigationManager Nav

<section id="home">

    <h1 class="hero-title">Inside Market</h1>
    <p class="hero-subtitle">
        Built for small businesses
    </p>

    <div class="contact-container">
        <div class="contact-form">

            @if(!string.IsNullOrEmpty(ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                    @ErrorMessage
                </MudAlert>
            }

            <EditForm Model="@_registerRequest" OnValidSubmit="@RegisterAsync">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="@_registerRequest.Email">Email</label>
                    <MudTextField @bind-Value="_registerRequest.Email"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  For="@(() => _registerRequest.Email)" />
                </div>

                <div class="form-group">
                    <label for="@_registerRequest.Password">Password</label>
                    <MudTextField @bind-Value="_registerRequest.Password"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Required="true"
                                  For="@(() => _registerRequest.Password)" />
                </div>

                <div class="form-group">
                    <label for="@_registerRequest.ConfirmPassword">Confirm Password</label>
                    <MudTextField @bind-Value="_registerRequest.ConfirmPassword"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Required="true"
                                  For="@(() => _registerRequest.ConfirmPassword)" />
                </div>

                <div class="form-group">
                    <label for="@_registerRequest.PhoneNumber">Phone Number</label>
                    <MudTextField @bind-Value="_registerRequest.PhoneNumber"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  For="@(() => _registerRequest.PhoneNumber)" />

                </div>

                <div class="form-group">
                    <label for="@_registerRequest.IsStoreAccount">Is this a store account?</label>
                    <MudSwitch @bind-Value="_registerRequest.IsStoreAccount"
                               Color="Color.Primary"/>

                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Class="submit-btn"
                           FullWidth="true"
                           Disabled="@_isBusy"
                           OnClick="RegisterAsync">

                    @if(_isBusy)
                    {
                        <MudProgressCircular Color="Color.Success" Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <MudText>Register</MudText>
                    }
                </MudButton>
            </EditForm>

            <MudText Class="mt-4 text-center" Color="Color.Warning">
                Already have an account?
                <MudLink Color="Color.Info" Href="/login">Login</MudLink>
            </MudText>

        </div>
    </div>
</section>


@code {

    private RegisterRequest _registerRequest = new();
    private bool _isBusy = false;
    private string? ErrorMessage;

    private async Task RegisterAsync()
    {
        ErrorMessage = null;
        _isBusy = true;

        var success = await AuthService.RegisterAsync(_registerRequest);

        _isBusy = false;

        if(success)
        {
            Nav.NavigateTo("/login",true);
        }
        else
        {
            ErrorMessage = "Invalid Inputs.";
        }
    }

}