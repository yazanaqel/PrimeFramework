@page "/register"
@layout LoginLayout
@inject IAuthService AuthService
@inject NavigationManager Nav


<MudPaper Class="pa-6 mx-auto mt-10" Elevation="8" MaxWidth="400px">

    <MudText Typo="Typo.h5" Class="mb-4">Create Account</MudText>

    @if(!string.IsNullOrEmpty(ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
            @ErrorMessage
        </MudAlert>
    }

    <EditForm Model="@_registerRequest" OnValidSubmit="@RegisterAsync">
        <DataAnnotationsValidator />

        <MudTextField @bind-Value="_registerRequest.Email"
                      Label="Email"
                      Variant="Variant.Outlined"
                      Required="true"
                      For="@(() => _registerRequest.Email)" />

        <MudTextField @bind-Value="_registerRequest.Password"
                      Label="Password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Required="true"
                      For="@(() => _registerRequest.Password)" />
                      
        <MudTextField @bind-Value="_registerRequest.ConfirmPassword"
                      Label="Confirm Password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Required="true"
                      For="@(() => _registerRequest.ConfirmPassword)" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Class="mt-4"
                   FullWidth="true"
                   Disabled="@_isBusy"
                   OnClick="RegisterAsync">
            @if(_isBusy)
            {
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Register</MudText>
            }
        </MudButton>

    </EditForm>
    
    <MudText Class="mt-4 text-center">
        Already have an account?
        <MudLink Href="/login">Login</MudLink>
    </MudText>

</MudPaper>


@code {

    private RegisterRequest _registerRequest = new();
    private bool _isBusy = false;
    private string? ErrorMessage;

    private async Task RegisterAsync()
    {
        ErrorMessage = null;
        _isBusy = true;

        var success = await AuthService.RegisterAsync(_registerRequest);

        _isBusy = false;

        if(success)
        {
            Nav.NavigateTo("/login",true);
        }
        else
        {
            ErrorMessage = "Invalid Inputs.";
        }
    }

}