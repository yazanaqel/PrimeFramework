@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@attribute [AllowAnonymous]

<MudThemeProvider IsDarkMode="true" />
<MudDialogProvider />
<MudSnackbarProvider />


<!-- Top App Bar -->
<nav style="position:fixed; top:0; left:0; right:0; z-index:1000;">
    <div class="nav-container">
        <div class="logo">INSIDE MARKET</div>

        @if(IsUserAuthenticated)
        {
            <MudIconButton Icon="@Icons.Material.Rounded.AddShoppingCart"
                           Color="Color.Default"
                           Size="Size.Large"
                           Href="/order/shopping-details" />

        }

        <div class="@_menuToggle" onclick="@ToggleDrawer">
            <span></span>
            <span></span>
            <span></span>
        </div>

        <ul class="@_navLinks">

            <li onclick="@ToggleDrawer"><a href="/settings">App Settings</a></li>

            @if(IsUserAuthenticated)
            {
                <li onclick="@ToggleDrawer"><a href="/user/get">Profile</a></li>

                <li onclick="@ConfirmLogout"><a style="cursor:pointer">Logout</a></li>
            }
            else
            {
                <li onclick="@ToggleDrawer"><a href="/login">Login</a></li>
            }

            <li onclick="@ToggleDrawer"><a href="/about-us">About Us</a></li>

        </ul>
    </div>
</nav>

<MudLayout Style="margin-top:64px;">

    <!-- Main Content -->
    <MudMainContent Class="content-with-bottom-nav">
        @Body
    </MudMainContent>

    <!-- Bottom Navigation -->
        <MudPaper Elevation="8"
              Class="bottom-nav d-flex justify-space-around pa-2">

        <MudIconButton Icon="@Icons.Material.Rounded.LocalMall"
                       Color="Color.Default"
                       Size="Size.Large"
                       Href="/house/all-stores" />

        <MudIconButton Icon="@Icons.Material.Rounded.Category"
                       Color="Color.Default"
                       Size="Size.Large"
                       Href="/house/all-products" />

                       
        @if(IsUserAuthenticated && IsMerchantUser)
        {
            <MudIconButton Icon="@Icons.Material.Rounded.ManageAccounts"
                           Color="Color.Default"
                           Size="Size.Large"
                           Href="/store/get" />

            <MudIconButton Icon="@Icons.Material.Rounded.InsertChart"
                           Color="Color.Default"
                           Size="Size.Large"
                           Href="/store/edit" />

        }




    </MudPaper>

</MudLayout>






@code {

    private string _menuToggle = "menu-toggle";
    private string _navLinks = "nav-links";
    bool _drawerOpen = false;
    bool IsUserAuthenticated = false;
    bool IsMerchantUser = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        IsUserAuthenticated = user.Identity?.IsAuthenticated == true;

        if(user.IsInRole("MERCHANT"))
        {
            IsMerchantUser = true;
        }
    }

    void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;

        _menuToggle = _drawerOpen ? "menu-toggle active" : "menu-toggle";

        _navLinks = _drawerOpen ? "nav-links active" : "nav-links";
    }

    private async Task ConfirmLogout()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            title: "Confirm Logout",
            markupMessage: (MarkupString)"Are you sure you want to logout?",
            yesText: "Logout",
            cancelText: "Cancel",
            options: new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true
            });

        if(result == true)
        {
            await AuthService.LogoutAsync();
            Nav.NavigateTo("/login",true);
        }
    }
}
