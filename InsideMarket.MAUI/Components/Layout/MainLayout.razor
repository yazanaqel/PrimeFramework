@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@attribute [AllowAnonymous]

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <!-- Top App Bar -->
    <MudAppBar Elevation="4" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6">Inside-Market</MudText>
        <MudSpacer />
        @if(IsUserAuthenticated)
        {
            <MudIconButton Icon="@Icons.Material.Outlined.AddShoppingCart"
                           Color="Color.Default"
                           Size="Size.Medium"
                           Href="/order/shopping-details" />
        }
    </MudAppBar>

    <!-- Left Drawer -->
    <MudDrawer @bind-Open="_drawerOpen" Elevation="4" ClipMode="DrawerClipMode.Always">
        <MudNavMenu>

            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">App Settings</MudNavLink>

            @if(IsUserAuthenticated)
            {
                <MudNavLink Href="/user/get" Icon="@Icons.Material.Filled.Person">Profile</MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.Logout" OnClick="ConfirmLogout">Logout</MudNavLink>
            }
            else
            {
                <MudNavLink Icon="@Icons.Material.Filled.Login" OnClick="@(() => Nav.NavigateTo("/login",true))">Login</MudNavLink>
            }

            <MudNavLink Href="/about-us" Icon="@Icons.Material.Filled.Info">About Us</MudNavLink>

        </MudNavMenu>



    </MudDrawer>

    <!-- Main Content -->
    <MudMainContent Class="content-with-bottom-nav">
        @Body
    </MudMainContent>

    <!-- Bottom Navigation -->
    <MudPaper Elevation="8"
              Class="bottom-nav d-flex justify-space-around pa-2">

        <MudIconButton Icon="@Icons.Material.Rounded.LocalMall"
                       Color="Color.Dark"
                       Size="Size.Medium"
                       Href="/house/all-stores" />

        <MudIconButton Icon="@Icons.Material.Rounded.Category"
                       Color="Color.Dark"
                       Size="Size.Medium"
                       Href="/house/all-products" />

                       
        @if(IsUserAuthenticated && IsMerchantUser)
        {
            <MudIconButton Icon="@Icons.Material.Rounded.ManageAccounts"
                           Color="Color.Dark"
                           Size="Size.Medium"
                           Href="/store/get" />

            <MudIconButton Icon="@Icons.Material.Rounded.Settings"
                           Color="Color.Dark"
                           Size="Size.Medium"
                           Href="/store/edit" />

        }




    </MudPaper>

</MudLayout>

@code {
    bool _drawerOpen = false;
    void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    bool IsUserAuthenticated = false;
    bool IsMerchantUser = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        IsUserAuthenticated = user.Identity?.IsAuthenticated == true;

        if(user.IsInRole("MERCHANT"))
        {
            IsMerchantUser = true;
        }
    }

    private async Task ConfirmLogout()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            title: "Confirm Logout",
            markupMessage: (MarkupString)"Are you sure you want to logout?",
            yesText: "Logout",
            cancelText: "Cancel",
            options: new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true
            });

        if(result == true)
        {
            await AuthService.LogoutAsync();
            Nav.NavigateTo("/login",true);
        }
    }
}
