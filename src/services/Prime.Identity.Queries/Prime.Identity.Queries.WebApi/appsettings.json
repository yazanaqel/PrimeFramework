{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=C:/Users/Yazan/source/repos/PrimeFramework/src/services/Prime.Identity/Prime.Identity.WebApi/InsideMarket.db"
  },

  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "redisDb"
  },

  "Serilog": {
    "Using": [ "SeriLog.Sinks.Console", "Serilog.Sinks.FiLe" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Database.Connection": "Information",
        "Microsoft.EntityFrameworkCore.Query": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "Path": "Logs/MyLog_FileJSON_.json",
          "rollingInterval": "Day"
        }
      }
    ],

    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "AllowedHosts": "*"
}
